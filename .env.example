APP_NAME=Auto Deploy
APP_ENV=development
REPOSITORY_ROOT=/opt/auto-deploy/repos
GIT_TIMEOUT_SECONDS=300
WORKER_POLL_SECONDS=2
CONTAINER_STARTUP_WAIT_SECONDS=3
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_MASTER_KEY=
SESSION_SECRET=change-this-session-secret-before-production
# Used only to bootstrap the first administrator on their first successful login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
GITHUB_WEBHOOK_SECRET=

# Host access for local Python development. Compose uses its postgres service internally.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auto_deploy
DATABASE_USER=auto_deploy
DATABASE_PASSWORD=auto_deploy
